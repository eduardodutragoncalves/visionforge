{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Dataset Manifest",
    "type": "object",
    "properties": {
        "id": { "type": "string" },
        "project_id": { "type": "string" },
        "root_path": { "type": "string" },
        "task": { "type": "string", "enum": ["classification", "detection"] },
        "format": { "type": "string", "enum": ["yolo", "coco", "pascal", "tfrecord"] },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "sources": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": { "type": "string", "enum": ["directory", "file", "video"] },
                    "path": { "type": "string" },
                    "added_at": { "type": "string" }
                },
                "required": ["type", "path"]
            },
            "default": []
        },
        "classes": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string" },
                    "color": { "type": "string" }
                },
                "required": ["id", "name"]
            },
            "default": []
        },
        "images": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "path": { "type": "string" },
                    "split": { "type": "string", "enum": ["unassigned", "train", "val", "test"] },
                    "labels": {
                        "type": "array",
                        "items": { "type": "integer" },
                        "default": []
                    },
                    "boxes": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "class_id": { "type": "integer" },
                                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                                "y": { "type": "number", "minimum": 0, "maximum": 1 },
                                "w": { "type": "number", "minimum": 0, "maximum": 1 },
                                "h": { "type": "number", "minimum": 0, "maximum": 1 }
                            },
                            "required": ["class_id", "x", "y", "w", "h"]
                        },
                        "default": []
                    }
                },
                "required": ["id", "path"]
            },
            "default": []
        }
    },
    "required": ["id", "project_id", "task", "format", "created_at", "updated_at"]
}
