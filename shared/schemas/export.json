{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Export Manifest",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "run_id": {
            "type": "string"
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "format": {
            "type": "string",
            "enum": [
                "onnx",
                "tflite",
                "torchscript",
                "saved_model"
            ]
        },
        "status": {
            "type": "string"
        },
        "path": {
            "type": "string"
        }
    },
    "required": [
        "id",
        "run_id",
        "format",
        "created_at"
    ]
}