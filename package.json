{
  "name": "visionforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n engine,desktop \"npm run dev:engine\" \"npm run dev:desktop\"",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dev:engine": "uvicorn engine.main:app --reload --port 8000",
    "autosync:start": "bash scripts/auto-commit-watch.sh start",
    "autosync:stop": "bash scripts/auto-commit-watch.sh stop",
    "autosync:restart": "bash scripts/auto-commit-watch.sh restart",
    "autosync:status": "bash scripts/auto-commit-watch.sh status",
    "autosync:once": "bash scripts/auto-sync.sh",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
